# ============================================================================
# Dockerfile: Next.js Studio Web Application
# ============================================================================
FROM node:22-alpine AS base

WORKDIR /app

COPY package*.json ./
COPY apps/web/package*.json ./apps/web/

RUN npm install

COPY . .

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

CMD ["npm", "run", "dev", "--prefix", "apps/web"]
