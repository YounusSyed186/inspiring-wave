# ============================================================================
# AUTONOMOUS MULTI-CHANNEL AI VIDEO STUDIO — ENVIRONMENT CONFIGURATION
# ============================================================================

# Google Gemini API Key (Required for research, scripting, and clipping heuristics)
GEMINI_API_KEY=your_gemini_api_key_here

# Free-First Mode (true enforces local tools; false allows configured paid APIs)
FREE_ONLY_MODE=true

# Daily & Monthly Cost Limits (USD)
DAILY_SPEND_LIMIT=5.00
MONTHLY_SPEND_LIMIT=50.00

# Supabase / PostgreSQL Credentials
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studio
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google OAuth 2.0 Credentials (for YouTube Data API v3 publishing)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Paths & Media Binaries
HYPERFRAMES_PYTHON=C:\Users\DELL\video-tools\Scripts\python.exe
HYPERFRAMES_WHISPER_PATH=C:\Users\DELL\whisper.cpp\Release\whisper-cli.exe
LEMO_OPUSCAR_DIR=C:\Users\DELL\lemo-opuscar
LOCAL_STORAGE_DIR=./local_storage
